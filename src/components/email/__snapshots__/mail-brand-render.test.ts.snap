>Ufakturerede timer</p><p style="color:#1A1D1C;font-size:22px;font-variant-numeric:tabular-nums;font-weight:700;line-height:28px;margin:0">12,5 t</p></td><td width="8" style="width:8px"></td><td bgcolor="#F2F3F0" style="background-color:#F2F3F0;border-radius:8px;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;padding:14px 14px;vertical-align:top;width:50%"><p class="tt-muted" style="color:#5F6663;font-size:13px;line-height:18px;margin:0 0 4px 0">Værdi</p><p style="color:#1A1D1C;font-size:22px;font-variant-numeric:tabular-nums;font-weight:700;line-height:28px;margin:0">8.000 kr.</p></td></tr></tbody></table><table style="border-collapse:collapse;margin:8px 0 16px;width:100%"><thead><tr><th class="tt-muted" style="border-bottom:1px solid #DFE2DE;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:13px;font-weight:600;padding:6px 0;text-align:left">Kunde</th><th class="tt-muted" style="border-bottom:1px solid #DFE2DE;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:13px;font-weight:600;padding:6px 0;text-align:right">Timer</th><th class="tt-muted" style="border-bottom:1px solid #DFE2DE;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:13px;font-weight:600;padding:6px 0;text-align:right">Værdi</th></tr></thead><tbody><tr><td style="border-bottom:1px solid #DFE2DE;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:15px;padding:8px 0">Kunde</td><td style="border-bottom:1px solid #DFE2DE;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:15px;padding:8px 0;font-variant-numeric:tabular-nums;text-align:right">12,5</td><td style="border-bottom:1px solid #DFE2DE;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:15px;padding:8px 0;font-variant-numeric:tabular-nums;text-align:right">8.000 kr.</td></tr></tbody></table><table role="presentation" border="0" cellPadding="0" cellSpacing="0" style="margin:8px 0 24px"><tbody><tr><td class="tt-btn-td" bgcolor="#1E5B47" style="background-color:#1E5B47;border-radius:8px"><a href="https://timetrack.dk/dashboard/invoices/new" class="tt-btn" style="background-color:#1E5B47;border:1px solid #1E5B47;border-radius:8px;color:#FFFFFF;display:inline-block;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:16px;font-weight:600;line-height:20px;padding:13px 22px;text-decoration:none">Opret faktura</a></td></tr></tbody></table><p style="font-size:14px;line-height:20px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:16px 0 0 0;margin-top:16px;margin-right:0;margin-bottom:0;margin-left:0">Påmindelsen kan slås fra under mailindstillinger.</p></td></tr><tr><td class="tt-footer" style="padding:16px 4px 0"><p style="font-size:12px;line-height:18px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 4px 0;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">Påmindelsen sendes hver fredag.<!-- --> <a href="http://localhost:3000/dashboard/settings/notifications" style="color:#5F6663;text-decoration-line:none;text-decoration:underline" target="_blank">Mailindstillinger</a></p><p style="font-size:12px;line-height:18px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 4px 0;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0"><a href="http://localhost:3000" style="color:#5F6663;text-decoration-line:none;text-decoration:underline" target="_blank">TimeTrack</a> <!-- -->er lavet af Mahoje v/ Mads Holst Jensen, CVR 39413892.</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"
`;

exports[`mails til en TimeTrack-konto er uændrede > VerificationEmail 1`] = `
"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="da"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><meta name="color-scheme" content="light dark"/><meta name="supported-color-schemes" content="light dark"/><meta name="x-apple-disable-message-reformatting"/><meta name="format-detection" content="telephone=no, date=no, address=no, email=no"/><style>:root { color-scheme: light dark; supported-color-schemes: light dark; }
