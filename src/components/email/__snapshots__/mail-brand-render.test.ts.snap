.tt-card td, .tt-card th, .tt-card hr, .tt-card { border-color: #2A2F2D !important; }
}
[data-ogsc] .tt-card h1, [data-ogsc] .tt-card h2, [data-ogsc] .tt-card strong { color: #ECEFED !important; }
[data-ogsc] .tt-card p, [data-ogsc] .tt-card td, [data-ogsc] .tt-card th, [data-ogsc] .tt-card div, [data-ogsc] .tt-card li { color: #ECEFED !important; }
[data-ogsc] .tt-card .tt-kv-label, [data-ogsc] .tt-card .tt-muted, [data-ogsc] .tt-footer p, [data-ogsc] .tt-header .tt-muted { color: #A3ABA7 !important; }
[data-ogsc] .tt-card .tt-kv-value { color: #ECEFED !important; }
[data-ogsc] .tt-card a:not([style*="background"]), [data-ogsc] .tt-footer a { color: #5FB38F !important; }
[data-ogsc] .tt-header .tt-wordmark { color: #ECEFED !important; }
[data-ogsc] .tt-card a.tt-btn { color: #0A0A0A !important; }
[data-ogsc] .tt-card a.tt-btn-secondary { color: #ECEFED !important; }
[data-ogsb] .tt-body, [data-ogsb] .tt-body > table > tbody > tr > td, [data-ogsb] .tt-page { background-color: #0A0A0A !important; }
[data-ogsb] .tt-card { background-color: #151816 !important; }
[data-ogsb] .tt-card table[style*="background"]:not(.tt-keep), [data-ogsb] .tt-card td[style*="background"]:not(.tt-btn-td):not(.tt-hul), [data-ogsb] .tt-card div[style*="background"], [data-ogsb] .tt-card p[style*="background"] { background-color: #1C201E !important; }
[data-ogsb] .tt-card td.tt-btn-td, [data-ogsb] .tt-card a.tt-btn { background-color: #5FB38F !important; }
[data-ogsb] .tt-card td.tt-btn-td-secondary, [data-ogsb] .tt-card a.tt-btn-secondary { background-color: transparent !important; border-color: #6B736F !important; }
[data-ogsb] .tt-card td.tt-hul-brugt { background-color: #5FB38F !important; border-color: #5FB38F !important; }
[data-ogsb] .tt-card td.tt-hul-halv { background-color: #18291F !important; border-color: #5FB38F !important; }
[data-ogsb] .tt-card td.tt-hul-tom { background-color: transparent !important; border-color: #5FB38F !important; }
[data-ogsb] .tt-card td, [data-ogsb] .tt-card th, [data-ogsb] .tt-card hr, [data-ogsb] .tt-card { border-color: #2A2F2D !important; }</style></head><body class="tt-body" style="background-color:#F2F3F0;margin:0;padding:0"><!--$--><!--html--><!--head--><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Velkommen til TimeTrack, Test. Tre trin, så er du i gang.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#F2F3F0;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0;padding:0"><table role="presentation" border="0" cellPadding="0" cellSpacing="0" width="100%" class="tt-page" bgcolor="#F2F3F0" style="background-color:#F2F3F0"><tbody><tr><td align="center" style="padding:24px 12px"><table role="presentation" border="0" cellPadding="0" cellSpacing="0" width="100%" style="max-width:600px;margin:0 auto"><tbody><tr><td class="tt-card" bgcolor="#FFFFFF" style="background-color:#FFFFFF;border:1px solid #DFE2DE;border-radius:10px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;padding:32px 28px"><p style="font-size:16px;line-height:24px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Hej Test,</p><p style="font-size:16px;line-height:24px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Jeg hedder Mads, og jeg bygger og driver TimeTrack. Jeg lavede det, så selvstændige kan holde styr på timer, klippekort og fakturaer uden et regneark ved siden af.</p><p style="font-size:16px;line-height:24px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Tre trin, så er du i gang:</p><table role="presentation" border="0" cellPadding="0" cellSpacing="0" width="100%" style="margin:16px 0"><tbody><tr><td bgcolor="#F2F3F0" style="background-color:#F2F3F0;border-radius:8px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:15px;line-height:24px;padding:14px 18px"><p style="font-size:15px;line-height:24px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 4px 0;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">1. Opret din første kunde</p><p style="font-size:15px;line-height:24px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 4px 0;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">2. Sæt din timepris og opret et projekt</p><p style="font-size:15px;line-height:24px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">3. Start timeren, når du går i gang med opgaven</p></td></tr></tbody></table><table role="presentation" border="0" cellPadding="0" cellSpacing="0" style="margin:8px 0 24px"><tbody><tr><td class="tt-btn-td" bgcolor="#1E5B47" style="background-color:#1E5B47;border-radius:8px"><a href="https://timetrack.dk/dashboard" class="tt-btn" style="background-color:#1E5B47;border:1px solid #1E5B47;border-radius:8px;color:#FFFFFF;display:inline-block;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:16px;font-weight:600;line-height:20px;padding:13px 22px;text-decoration:none">Åbn TimeTrack</a></td></tr></tbody></table><p style="font-size:16px;line-height:24px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Hvad fik dig til at prøve TimeTrack? Svar gerne på mailen. Jeg læser selv alle svar, og det hjælper mig med at bygge det rigtige.</p><p style="font-size:14px;line-height:20px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:16px 0 0 0;margin-top:16px;margin-right:0;margin-bottom:0;margin-left:0">Har du spørgsmål, kan du altid skrive direkte til mig på <a href="mailto:mads@timetrack.dk" style="color:#1E5B47;text-decoration-line:none;text-decoration:underline" target="_blank">mads@timetrack.dk</a>.</p><hr style="width:100%;border:none;border-top:1px solid #eaeaea;border-color:#DFE2DE;margin:24px 0 16px"/><table role="presentation" border="0" cellPadding="0" cellSpacing="0"><tbody><tr><td style="padding-right:14px;vertical-align:middle"><img alt="Mads Holst Jensen" height="56" src="https://timetrack.dk/brand/mads-128.jpg" style="display:block;outline:none;border:0;text-decoration:none;border-radius:50%;height:56px;width:56px" width="56"/></td><td style="vertical-align:middle"><p style="font-size:16px;line-height:24px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 2px 0;margin-top:0;margin-right:0;margin-bottom:2px;margin-left:0">Mads Holst Jensen</p><p class="tt-muted" style="font-size:14px;line-height:20px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Bygger og driver TimeTrack</p></td></tr></tbody></table></td></tr><tr><td class="tt-footer" style="padding:16px 4px 0"><p style="font-size:12px;line-height:18px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 4px 0;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">Du modtager denne mail, fordi du har oprettet en konto på TimeTrack.<!-- --> <a href="http://localhost:3000/dashboard/settings/notifications" style="color:#5F6663;text-decoration-line:none;text-decoration:underline" target="_blank">Mailindstillinger</a>.</p><p style="font-size:12px;line-height:18px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 4px 0;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0"><a href="http://localhost:3000" style="color:#5F6663;text-decoration-line:none;text-decoration:underline" target="_blank">TimeTrack</a> <!-- -->er lavet af Mahoje v/ Mads Holst Jensen, CVR 39413892.</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"
`;

