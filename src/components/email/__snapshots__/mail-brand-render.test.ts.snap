 href="http://localhost:3000" style="color:#1A1D1C;text-decoration:none"><img alt="" height="32" src="https://timetrack.dk/brand/tt-ikon-64.png" style="display:inline-block;outline:none;border:0;text-decoration:none;height:32px;vertical-align:middle;width:32px" width="32"/><span class="tt-wordmark" style="color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:18px;font-weight:700;letter-spacing:-0.02em;line-height:32px;padding-left:10px;vertical-align:middle">TimeTrack</span></a></td><td align="right" class="tt-muted" style="color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:13px;line-height:32px;vertical-align:middle">Månedsrapport</td></tr></tbody></table></td></tr><tr><td class="tt-card" bgcolor="#FFFFFF" style="background-color:#FFFFFF;border:1px solid #DFE2DE;border-radius:10px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;padding:32px 28px"><h1 style="color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:24px;font-weight:700;letter-spacing:-0.02em;line-height:30px;margin:0 0 16px 0">oktober 2026</h1><p style="font-size:16px;line-height:24px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Hej Test,</p><p style="font-size:16px;line-height:24px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Her er måneden i tal og året indtil videre.</p><table role="presentation" border="0" cellPadding="0" cellSpacing="0" width="100%" style="border-collapse:separate;margin:8px 0 16px"><tbody><tr><td bgcolor="#F2F3F0" style="background-color:#F2F3F0;border-radius:8px;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;padding:14px 14px;vertical-align:top;width:33%"><p class="tt-muted" style="color:#5F6663;font-size:13px;line-height:18px;margin:0 0 4px 0">Timer</p><p style="color:#1A1D1C;font-size:22px;font-variant-numeric:tabular-nums;font-weight:700;line-height:28px;margin:0">100 t</p><p style="color:#5F6663;font-size:13px;line-height:18px;margin:4px 0 0 0">Første måned med data</p></td><td width="8" style="width:8px"></td><td bgcolor="#F2F3F0" style="background-color:#F2F3F0;border-radius:8px;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;padding:14px 14px;vertical-align:top;width:33%"><p class="tt-muted" style="color:#5F6663;font-size:13px;line-height:18px;margin:0 0 4px 0">Omsætning</p><p style="color:#1A1D1C;font-size:22px;font-variant-numeric:tabular-nums;font-weight:700;line-height:28px;margin:0">50.000 kr.</p><p style="color:#5F6663;font-size:13px;line-height:18px;margin:4px 0 0 0">25 % mere end forrige måned</p></td><td width="8" style="width:8px"></td><td bgcolor="#F2F3F0" style="background-color:#F2F3F0;border-radius:8px;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;padding:14px 14px;vertical-align:top;width:33%"><p class="tt-muted" style="color:#5F6663;font-size:13px;line-height:18px;margin:0 0 4px 0">Året 2026</p><p style="color:#1A1D1C;font-size:22px;font-variant-numeric:tabular-nums;font-weight:700;line-height:28px;margin:0">300.000 kr.</p><p style="color:#5F6663;font-size:13px;line-height:18px;margin:4px 0 0 0">i alt</p></td></tr></tbody></table><table role="presentation" border="0" cellPadding="0" cellSpacing="0" width="100%" style="border-collapse:collapse;margin:8px 0 16px"><tbody><tr class="tt-kv-row"><td class="tt-kv-label" style="border-bottom:1px solid #DFE2DE;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:15px;padding:9px 0;width:40%">Betalte fakturaer</td><td class="tt-kv-value" style="border-bottom:1px solid #DFE2DE;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:15px;font-variant-numeric:tabular-nums;font-weight:500;padding:9px 0;text-align:right">2 (10.000 kr.)</td></tr><tr class="tt-kv-row"><td class="tt-kv-label" style="border-bottom:1px solid #DFE2DE;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:15px;padding:9px 0;width:40%">Udestående</td><td class="tt-kv-value" style="border-bottom:1px solid #DFE2DE;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:17px;font-variant-numeric:tabular-nums;font-weight:700;padding:9px 0;text-align:right">1 (500 kr.)</td></tr></tbody></table><table style="border-collapse:collapse;margin:8px 0 16px;width:100%"><thead><tr><th class="tt-muted" style="border-bottom:1px solid #DFE2DE;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:13px;font-weight:600;padding:6px 0;text-align:left">Kunde</th><th class="tt-muted" style="border-bottom:1px solid #DFE2DE;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:13px;font-weight:600;padding:6px 0;text-align:right">Timer</th><th class="tt-muted" style="border-bottom:1px solid #DFE2DE;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:13px;font-weight:600;padding:6px 0;text-align:right">Omsætning</th></tr></thead><tbody><tr><td style="border-bottom:1px solid #DFE2DE;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:15px;padding:8px 0">Kunde</td><td style="border-bottom:1px solid #DFE2DE;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:15px;padding:8px 0;font-variant-numeric:tabular-nums;text-align:right">10</td><td style="border-bottom:1px solid #DFE2DE;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:15px;padding:8px 0;font-variant-numeric:tabular-nums;text-align:right">5.000 kr.</td></tr></tbody></table><table role="presentation" border="0" cellPadding="0" cellSpacing="0" width="100%" style="margin:16px 0"><tbody><tr><td bgcolor="#FFF7E6" style="background-color:#FFF7E6;border-left:3px solid #B45309;border-radius:6px;color:#7A3E06;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:15px;line-height:22px;padding:12px 16px"><p style="color:#7A3E06;font-size:15px;font-weight:700;margin:0 0 4px 0">Klippekort at holde øje med</p><div>1 med lav saldo</div><div>1 udløber snart</div><div>3 aktive klippekort i alt.</div></td></tr></tbody></table><table role="presentation" border="0" cellPadding="0" cellSpacing="0" style="margin:8px 0 24px"><tbody><tr><td class="tt-btn-td" bgcolor="#1E5B47" style="background-color:#1E5B47;border-radius:8px"><a href="https://timetrack.dk/dashboard/reports" class="tt-btn" style="background-color:#1E5B47;border:1px solid #1E5B47;border-radius:8px;color:#FFFFFF;display:inline-block;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:16px;font-weight:600;line-height:20px;padding:13px 22px;text-decoration:none">Åbn rapporten</a></td></tr></tbody></table><p style="font-size:14px;line-height:20px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:16px 0 0 0;margin-top:16px;margin-right:0;margin-bottom:0;margin-left:0">Månedsrapporten kan slås fra under mailindstillinger.</p></td></tr><tr><td class="tt-footer" style="padding:16px 4px 0"><p style="font-size:12px;line-height:18px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 4px 0;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">Rapporten sendes den 1. i hver måned.<!-- --> <a href="http://localhost:3000/dashboard/settings/notifications" style="color:#5F6663;text-decoration-line:none;text-decoration:underline" target="_blank">Mailindstillinger</a></p><p style="font-size:12px;line-height:18px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 4px 0;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0"><a href="http://localhost:3000" style="color:#5F6663;text-decoration-line:none;text-decoration:underline" target="_blank">TimeTrack</a> <!-- -->er lavet af Mahoje v/ Mads Holst Jensen, CVR 39413892.</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"
`;

exports[`mails til en TimeTrack-konto er uændrede > NewLoginEmail 1`] = `
