alt="" height="32" src="https://timetrack.dk/brand/tt-ikon-64.png" style="display:inline-block;outline:none;border:0;text-decoration:none;height:32px;vertical-align:middle;width:32px" width="32"/><span class="tt-wordmark" style="color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:18px;font-weight:700;letter-spacing:-0.02em;line-height:32px;padding-left:10px;vertical-align:middle">TimeTrack</span></a></td><td align="right" class="tt-muted" style="color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:13px;line-height:32px;vertical-align:middle">Betaling</td></tr></tbody></table></td></tr><tr><td class="tt-card" bgcolor="#FFFFFF" style="background-color:#FFFFFF;border:1px solid #DFE2DE;border-radius:10px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;padding:32px 28px"><h1 style="color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:24px;font-weight:700;letter-spacing:-0.02em;line-height:30px;margin:0 0 16px 0">Betalingen mislykkedes</h1><p style="font-size:16px;line-height:24px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Hej Test,</p><p style="font-size:16px;line-height:24px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Din seneste betaling for TimeTrack-abonnementet (<strong>79,00 kr.</strong>) kunne ikke gennemføres.</p><table role="presentation" border="0" cellPadding="0" cellSpacing="0" width="100%" style="margin:16px 0"><tbody><tr><td bgcolor="#FDF0EF" style="background-color:#FDF0EF;border-left:3px solid #B42318;border-radius:6px;color:#8A1C13;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:15px;line-height:22px;padding:12px 16px"><p style="color:#8A1C13;font-size:15px;font-weight:700;margin:0 0 4px 0">Handling påkrævet</p>Opdatér din betalingsmetode, så din adgang ikke bliver afbrudt. Betalingen forsøges automatisk igen inden for de næste dage.</td></tr></tbody></table><table role="presentation" border="0" cellPadding="0" cellSpacing="0" style="margin:8px 0 24px"><tbody><tr><td class="tt-btn-td" bgcolor="#1E5B47" style="background-color:#1E5B47;border-radius:8px"><a href="https://example.com/x" class="tt-btn" style="background-color:#1E5B47;border:1px solid #1E5B47;border-radius:8px;color:#FFFFFF;display:inline-block;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:16px;font-weight:600;line-height:20px;padding:13px 22px;text-decoration:none">Opdatér betalingsmetode</a></td></tr></tbody></table><p style="font-size:14px;line-height:20px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:16px 0 0 0;margin-top:16px;margin-right:0;margin-bottom:0;margin-left:0">Spørgsmål? Skriv til <a href="mailto:support@timetrack.dk" style="color:#1E5B47;text-decoration-line:none;text-decoration:underline" target="_blank">support@timetrack.dk</a>.</p></td></tr><tr><td class="tt-footer" style="padding:16px 4px 0"><p style="font-size:12px;line-height:18px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 4px 0;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">Dette er en automatisk betalingsmeddelelse.</p><p style="font-size:12px;line-height:18px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 4px 0;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0"><a href="http://localhost:3000" style="color:#5F6663;text-decoration-line:none;text-decoration:underline" target="_blank">TimeTrack</a> <!-- -->er lavet af Mahoje v/ Mads Holst Jensen, CVR 39413892.</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"
`;

