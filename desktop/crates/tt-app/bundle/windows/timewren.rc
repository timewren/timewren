// Windows-ressourcer for timewren.exe (indlejres af crates/tt-app/build.rs).
//
// Ikonet SKAL have id 1: GPUI henter vinduets ikon (titellinje, Alt+Tab,
// proceslinje) med LoadImageW(modul, 1, IMAGE_ICON), og Stifinder bruger det
// første ikon som exe'ens ikon. Uden det vises Windows' generiske ikon.
// TT_MAJOR/TT_MINOR/TT_PATCH sættes af build.rs ud fra Cargo.toml.

#define TT_STR2(x) #x
#define TT_STR(x) TT_STR2(x)
#define TT_VERSION_STR TT_STR(TT_MAJOR) "." TT_STR(TT_MINOR) "." TT_STR(TT_PATCH)

1 ICON "TimeWren.ico"

1 VERSIONINFO
FILEVERSION TT_MAJOR, TT_MINOR, TT_PATCH, 0
PRODUCTVERSION TT_MAJOR, TT_MINOR, TT_PATCH, 0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Mahope"
      VALUE "FileDescription", "TimeWren"
      VALUE "ProductName", "TimeWren"
      VALUE "OriginalFilename", "timewren.exe"
      VALUE "LegalCopyright", "Mahope"
      VALUE "FileVersion", TT_VERSION_STR
      VALUE "ProductVersion", TT_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
