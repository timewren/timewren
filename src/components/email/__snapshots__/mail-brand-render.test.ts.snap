[data-ogsb] .tt-card td.tt-hul-brugt { background-color: #5FB38F !important; border-color: #5FB38F !important; }
[data-ogsb] .tt-card td.tt-hul-halv { background-color: #18291F !important; border-color: #5FB38F !important; }
[data-ogsb] .tt-card td.tt-hul-tom { background-color: transparent !important; border-color: #5FB38F !important; }
