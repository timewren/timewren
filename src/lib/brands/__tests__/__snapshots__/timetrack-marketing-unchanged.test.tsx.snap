exports[`timetrack.dk: forside og prisside er uændrede > prissiden: metadata og HTML > html 1`] = `"<div class="tt-lys min-h-screen bg-tt-papir text-tt-blaek"><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Hvad sker der efter de 30 dage?","acceptedAnswer":{"@type":"Answer","text":"Efter 30 dage fortsætter kontoen på Gratis, hvis du ikke vælger en plan. Intet betalingskort. Gratis har plads til 3 brugere og 3 aktive kunder. Fakturering og klippekort er med. Vælger I ikke en plan efter 30 dage, fortsætter organisationen på Gratis med plads til 3 brugere. Er I flere, beholder ejeren og de næste i rækken adgang, og resten er sat på pause, til I vælger en plan. Ingen data slettes."}},{"@type":"Question","name":"Er der binding?","acceptedAnswer":{"@type":"Answer","text":"Nej, ikke på månedsabonnementet. Du kan opsige, når du vil."}},{"@type":"Question","name":"Hvad koster ekstra brugere?","acceptedAnswer":{"@type":"Answer","text":"Team koster 49 kr. pr. bruger/md. (mindst 2 brugere, op til 25). Virksomhed koster 69 kr. pr. bruger/md. (mindst 5 brugere). Er I flere end 50, så skriv til mig. Alle priser er ekskl. moms."}},{"@type":"Question","name":"Hvor ligger mine data?","acceptedAnswer":{"@type":"Answer","text":"Databasen ligger hos Hetzner i Tyskland, og filer og backup hos Hetzner i Finland. Enkelte underleverandører, fx til mail og fejlrapporter, er amerikanske."}}]}</script><nav aria-label="Hovedmenu" class="tt-lys fixed inset-x-0 top-0 z-50 border-b bg-tt-papir transition-colors border-transparent"><div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8"><div class="flex h-16 items-center justify-between gap-6"><a aria-label="TimeTrack forside" class="rounded-lg" href="/"><span class="flex items-center gap-2  "><svg viewBox="0 0 32 32" width="28" height="28" class="shrink-0 " aria-hidden="true"><defs><mask id="tt-ikon-m-_R_5a_" maskUnits="userSpaceOnUse" x="0" y="0" width="32" height="32"><rect x="3" y="8" width="26" height="16" rx="2.5" fill="#fff"></rect><g fill="#000"><circle cx="3" cy="16" r="3"></circle><circle cx="29" cy="16" r="3"></circle><circle cx="17" cy="16" r="5.6"></circle></g></mask></defs><rect width="32" height="32" rx="7" style="fill:var(--tt-gran)"></rect><g style="fill:var(--tt-paa-gran)"><rect width="32" height="32" mask="url(#tt-ikon-m-_R_5a_)"></rect><rect x="16.2" y="12" width="1.6" height="4.8" rx=".8"></rect><rect x="16.2" y="15.2" width="4" height="1.8" rx=".8"></rect></g></svg><span class="text-lg font-bold tracking-[-0.02em] text-tt-blaek">TimeTrack</span></span></a><div class="hidden flex-1 items-center justify-end gap-7 lg:flex"><a class="text-[15px] transition-colors hover:text-tt-blaek text-tt-graa" href="/selvstaendig">Selvstændige</a><a class="text-[15px] transition-colors hover:text-tt-blaek text-tt-graa" href="/teams-og-bureauer">Bureauer</a><a class="text-[15px] transition-colors hover:text-tt-blaek text-tt-graa" href="/virksomheder">Virksomheder</a><a class="text-[15px] transition-colors hover:text-tt-blaek text-tt-graa" href="/privat">Privat</a><a class="text-[15px] transition-colors hover:text-tt-blaek text-tt-graa" href="/pricing">Priser</a><a class="text-[15px] font-medium text-tt-blaek hover:text-tt-gran" href="/login">Log ind</a><a class="inline-flex min-h-10 items-center rounded-lg bg-tt-gran px-4 text-[15px] font-semibold text-tt-paa-gran transition-colors hover:bg-tt-gran-moerk" href="/register">Prøv gratis</a></div><button type="button" aria-expanded="false" aria-controls="nav-mobile" aria-label="Åbn menu" class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-tt-blaek hover:bg-tt-flade lg:hidden"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu h-6 w-6" aria-hidden="true"><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"></path></svg></button></div></div></nav><main><section class="pt-28 pb-12 sm:pt-36 sm:pb-16"><div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8"><a class="group inline-flex max-w-full items-center gap-2 rounded-full border border-tt-streg bg-tt-gran-lys px-3.5 py-1.5 text-[13px] font-medium text-tt-gran transition-colors hover:border-tt-gran/30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tt-fokus sm:text-sm motion-reduce:transition-none " href="/tillid"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock h-3.5 w-3.5 shrink-0" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg><span>Dansk. Database og backup i EU.</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 shrink-0 transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><h1 class="text-balance text-[40px] font-bold leading-[1.05] tracking-[-0.035em] sm:text-[56px] lg:text-[64px] lg:leading-[1.02] mt-4 max-w-4xl">Prøv den plan, der passer, gratis i 30 dage</h1><p class="text-lg leading-relaxed text-tt-graa sm:text-xl mt-6 max-w-2xl">Efter 30 dage fortsætter kontoen på Gratis, hvis du ikke vælger en plan. Intet betalingskort. Alle priser er ekskl. moms.</p></div></section><section aria-label="Planer" class="pb-16"><div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8"><ul class="border-t border-tt-streg"><li class="-mx-4 grid gap-6 border-b border-tt-streg px-4 py-8 sm:-mx-6 sm:px-6 lg:grid-cols-[1fr_1fr_1.3fr_12rem] lg:items-start lg:gap-10 rounded-[14px] bg-tt-gran-lys"><div><h2 class="text-2xl font-bold tracking-[-0.02em] text-tt-blaek">Selvstændig</h2><p class="mt-1 text-tt-graa">Til selvstændige</p></div><div><p class="text-[32px] font-bold leading-none tracking-[-0.03em] text-tt-blaek">79 kr.<span class="ml-1.5 text-base font-medium tracking-normal text-tt-graa">/md.</span></p><p class="mt-1 text-sm text-tt-graa">eller 790 kr./år</p></div><ul class="space-y-1.5 text-[15px] text-tt-blaek"><li>Én bruger og ubegrænset antal kunder</li><li>Klippekort og kundeportal</li><li>Fakturagrundlag til Billy og Dinero, PDF og CSV</li><li>Web, browserudvidelse, desktop-app og app til iPhone</li></ul><div><a href="/register" class="plausible-event-name=CTA+Click lg:w-full inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-lg bg-tt-gran px-5 text-base font-semibold text-tt-paa-gran transition-colors hover:bg-tt-gran-moerk">Prøv Selvstændig</a></div></li><li class="-mx-4 grid gap-6 border-b border-tt-streg px-4 py-8 sm:-mx-6 sm:px-6 lg:grid-cols-[1fr_1fr_1.3fr_12rem] lg:items-start lg:gap-10 "><div><h2 class="text-2xl font-bold tracking-[-0.02em] text-tt-blaek">Team</h2><p class="mt-1 text-tt-graa">Til små bureauer og teams</p></div><div><p class="text-[32px] font-bold leading-none tracking-[-0.03em] text-tt-blaek">49 kr.<span class="ml-1.5 text-base font-medium tracking-normal text-tt-graa">pr. bruger/md.</span></p><p class="mt-2 text-sm text-tt-graa">mindst 2 brugere</p><p class="mt-1 text-sm text-tt-graa">Fra 98 kr./md. for 2 brugere, eller 980 kr./år</p><p class="mt-1 text-sm text-tt-graa">Op til 25 brugere</p></div><ul class="space-y-1.5 text-[15px] text-tt-blaek"><li>Alt fra Selvstændig</li><li>Fælles kunder, projekter og klippekort</li><li>Teamoverblik pr. dag og uge</li><li>Timepriser pr. medlem</li></ul><div><a href="/register?plan=team" class="plausible-event-name=CTA+Click lg:w-full inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-lg border border-tt-kant bg-tt-papir px-5 text-base font-semibold text-tt-blaek transition-colors hover:bg-tt-flade">Prøv Team</a></div></li><li class="-mx-4 grid gap-6 border-b border-tt-streg px-4 py-8 sm:-mx-6 sm:px-6 lg:grid-cols-[1fr_1fr_1.3fr_12rem] lg:items-start lg:gap-10 "><div><h2 class="text-2xl font-bold tracking-[-0.02em] text-tt-blaek">Virksomhed</h2><p class="mt-1 text-tt-graa">Til virksomheder med lovkravet</p></div><div><p class="text-[32px] font-bold leading-none tracking-[-0.03em] text-tt-blaek">69 kr.<span class="ml-1.5 text-base font-medium tracking-normal text-tt-graa">pr. bruger/md.</span></p><p class="mt-2 text-sm text-tt-graa">mindst 5 brugere</p><p class="mt-1 text-sm text-tt-graa">Fra 345 kr./md. for 5 brugere, eller 3.450 kr./år</p><p class="mt-1 text-sm text-tt-graa">Flere end 50 brugere: skriv til mig</p></div><ul class="space-y-1.5 text-[15px] text-tt-blaek"><li>Alt fra Team</li><li>Check ind og ud, ferie, fravær og flex</li><li>Godkendelser og løneksport</li><li>Login med Microsoft Entra</li></ul><div><a href="/register?plan=business" class="plausible-event-name=CTA+Click lg:w-full inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-lg border border-tt-kant bg-tt-papir px-5 text-base font-semibold text-tt-blaek transition-colors hover:bg-tt-flade">Prøv Virksomhed</a></div></li><li class="-mx-4 grid gap-6 border-b border-tt-streg px-4 py-8 sm:-mx-6 sm:px-6 lg:grid-cols-[1fr_1fr_1.3fr_12rem] lg:items-start lg:gap-10 "><div><h2 class="text-2xl font-bold tracking-[-0.02em] text-tt-blaek">Privat</h2><p class="mt-1 text-tt-graa">Til privatpersoner</p></div><div><p class="text-[32px] font-bold leading-none tracking-[-0.03em] text-tt-blaek">29 kr.<span class="ml-1.5 text-base font-medium tracking-normal text-tt-graa">/md.</span></p><p class="mt-1 text-sm text-tt-graa">eller 290 kr./år</p></div><ul class="space-y-1.5 text-[15px] text-tt-blaek"><li>Én bruger og op til 10 aktive kunder</li><li>Med fakturering og klippekort</li></ul><div><a href="/register?plan=privat" class="plausible-event-name=CTA+Click lg:w-full inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-lg border border-tt-kant bg-tt-papir px-5 text-base font-semibold text-tt-blaek transition-colors hover:bg-tt-flade">Prøv Privat</a></div></li><li class="-mx-4 grid gap-6 border-b border-tt-streg px-4 py-8 sm:-mx-6 sm:px-6 lg:grid-cols-[1fr_1fr_1.3fr_12rem] lg:items-start lg:gap-10 "><div><h2 class="text-2xl font-bold tracking-[-0.02em] text-tt-blaek">Gratis</h2><p class="mt-1 text-tt-graa">Til at komme i gang</p></div><div><p class="text-[32px] font-bold leading-none tracking-[-0.03em] text-tt-blaek">0 kr.</p></div><ul class="space-y-1.5 text-[15px] text-tt-blaek"><li>3 brugere og 3 aktive kunder, med fakturering og klippekort</li><li>Alle apps er med</li></ul><div><a href="/register" class="plausible-event-name=CTA+Click lg:w-full inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-lg border border-tt-kant bg-tt-papir px-5 text-base font-semibold text-tt-blaek transition-colors hover:bg-tt-flade">Opret gratis konto</a></div></li></ul><div class="text-sm leading-relaxed text-tt-graa mt-6 max-w-3xl space-y-2"><p>Alle priser er ekskl. moms. Intet betalingskort for at prøve, ingen binding på månedsabonnementet og intet oprettelsesgebyr.</p><p>Vælger I ikke en plan efter 30 dage, fortsætter organisationen på Gratis med plads til 3 brugere. Er I flere, beholder ejeren og de næste i rækken adgang, og resten er sat på pause, til I vælger en plan. Ingen data slettes.</p><p>Desktop-appen, browserudvidelsen og appen til iPhone og iPad er med i alle planer. <a class="font-medium text-tt-gran underline decoration-tt-gran/40 underline-offset-2 hover:decoration-tt-gran" href="/team-prisberegner">Beregn prisen for jeres team</a></p></div></div></section><section class="border-t border-tt-streg py-20 sm:py-24"><div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8"><figure class="flex items-start gap-4 "><img alt="" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-12 w-12 shrink-0 rounded-full object-cover" style="color:transparent" srcset="/_next/image?url=%2Ftestimonials%2Fanna-testsen.jpg&amp;w=48&amp;q=75 1x, /_next/image?url=%2Ftestimonials%2Fanna-testsen.jpg&amp;w=96&amp;q=75 2x" src="/_next/image?url=%2Ftestimonials%2Fanna-testsen.jpg&amp;w=96&amp;q=75"><blockquote><p class="text-lg leading-relaxed text-tt-blaek">“Ikke alene er systemet nemt og overskueligt at bruge, men servicen er også i top.”</p><figcaption class="mt-2 text-sm text-tt-graa"><span class="font-semibold text-tt-blaek">Anna Testsen</span>, Testkunde ApS</figcaption></blockquote></figure></div></section><section class="border-t border-tt-streg py-20 sm:py-24"><div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 grid gap-10 lg:grid-cols-[1fr_2fr] lg:gap-16"><div><h2 class="text-balance text-[32px] font-bold leading-[1.08] tracking-[-0.03em] sm:text-[44px] sm:leading-[1.06]">Spørgsmål om pris</h2><div class="flex items-start gap-4 rounded-[14px] bg-tt-flade p-4 sm:gap-5 sm:p-5 mt-8"><img alt="" loading="lazy" width="56" height="56" decoding="async" data-nimg="1" class="h-14 w-14 shrink-0 rounded-full object-cover ring-2 ring-tt-gran" style="color:transparent" srcset="/_next/image?url=%2Fbrand%2Fmads-160.jpg&amp;w=64&amp;q=75 1x, /_next/image?url=%2Fbrand%2Fmads-160.jpg&amp;w=128&amp;q=75 2x" src="/_next/image?url=%2Fbrand%2Fmads-160.jpg&amp;w=128&amp;q=75"><div class="min-w-0"><p class="text-[15px] font-semibold text-tt-blaek">Mads Holst Jensen<span class="font-normal text-tt-graa">, stifter</span></p><p class="mt-1 text-[15px] leading-relaxed text-tt-graa">Jeg bygger TimeTrack i Danmark og svarer selv på support.</p><ul class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[13px] text-tt-graa"><li>CVR 39413892</li><li>Database og backup i EU</li><li><a class="font-medium text-tt-gran underline decoration-tt-gran/40 underline-offset-2 hover:decoration-tt-gran" href="/tillid">Læs om tillid og data</a></li></ul></div></div></div><div><div class="divide-y divide-tt-streg border-y border-tt-streg"><details class="group py-5"><summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 font-semibold text-tt-blaek [&amp;::-webkit-details-marker]:hidden">Hvad sker der efter de 30 dage?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-5 w-5 shrink-0 text-tt-graa transition-transform group-open:rotate-90" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></summary><div class="mt-3 max-w-3xl text-[17px] leading-relaxed text-tt-graa"><p>Efter 30 dage fortsætter kontoen på Gratis, hvis du ikke vælger en plan. Intet betalingskort. Gratis har plads til 3 brugere og 3 aktive kunder. Fakturering og klippekort er med.</p><p class="mt-2">Vælger I ikke en plan efter 30 dage, fortsætter organisationen på Gratis med plads til 3 brugere. Er I flere, beholder ejeren og de næste i rækken adgang, og resten er sat på pause, til I vælger en plan. Ingen data slettes.</p></div></details><details class="group py-5"><summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 font-semibold text-tt-blaek [&amp;::-webkit-details-marker]:hidden">Er der binding?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-5 w-5 shrink-0 text-tt-graa transition-transform group-open:rotate-90" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></summary><div class="mt-3 max-w-3xl text-[17px] leading-relaxed text-tt-graa">Nej, ikke på månedsabonnementet. Du kan opsige, når du vil, og fortsætter så på Gratis uden at miste data. Betaler du for et år ad gangen, svarer prisen til 10 måneder.</div></details><details class="group py-5"><summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 font-semibold text-tt-blaek [&amp;::-webkit-details-marker]:hidden">Hvilken plan skal et bureau prøve?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-5 w-5 shrink-0 text-tt-graa transition-transform group-open:rotate-90" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></summary><div class="mt-3 max-w-3xl text-[17px] leading-relaxed text-tt-graa">Team. I prøver Team gratis i 30 dage, og det koster bagefter 49 kr. pr. bruger/md., mindst 2 brugere.</div></details><details class="group py-5"><summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 font-semibold text-tt-blaek [&amp;::-webkit-details-marker]:hidden">Hvad koster ekstra brugere?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-5 w-5 shrink-0 text-tt-graa transition-transform group-open:rotate-90" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></summary><div class="mt-3 max-w-3xl text-[17px] leading-relaxed text-tt-graa">Team koster 49 kr. pr. bruger/md. (mindst 2 brugere, op til 25). Virksomhed koster 69 kr. pr. bruger/md. (mindst 5 brugere). Er I flere end 50, så skriv til mig. Alle priser er ekskl. moms.</div></details><details class="group py-5"><summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 font-semibold text-tt-blaek [&amp;::-webkit-details-marker]:hidden">Kan jeg skifte plan senere?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-5 w-5 shrink-0 text-tt-graa transition-transform group-open:rotate-90" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></summary><div class="mt-3 max-w-3xl text-[17px] leading-relaxed text-tt-graa">Ja. Start alene på Selvstændig. Får du brug for flere hænder, skifter du til Team under Indstillinger → Abonnement og inviterer dem derfra. Dine kunder, projekter og klippekort bliver på samme konto.</div></details><details class="group py-5"><summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 font-semibold text-tt-blaek [&amp;::-webkit-details-marker]:hidden">Skal jeg bruge Billy eller Dinero?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-5 w-5 shrink-0 text-tt-graa transition-transform group-open:rotate-90" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></summary><div class="mt-3 max-w-3xl text-[17px] leading-relaxed text-tt-graa">Nej. Du kan bruge TimeTrack uden integrationer og hente timerne som PDF og CSV.</div></details><details class="group py-5"><summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 font-semibold text-tt-blaek [&amp;::-webkit-details-marker]:hidden">Hvor ligger mine data?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-5 w-5 shrink-0 text-tt-graa transition-transform group-open:rotate-90" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></summary><div class="mt-3 max-w-3xl text-[17px] leading-relaxed text-tt-graa">Databasen ligger hos Hetzner i Tyskland, og filer og backup hos Hetzner i Finland. Enkelte underleverandører, fx til mail og fejlrapporter, er amerikanske. <a class="font-medium text-tt-gran underline decoration-tt-gran/40 underline-offset-2 hover:decoration-tt-gran" href="/tillid">Se alle databehandlere, backup og sletning</a>.</div></details></div></div></div></section></main><footer class="tt-lys border-t border-tt-streg bg-tt-flade-varm py-16 text-tt-blaek"><div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8"><div class="grid gap-12 lg:grid-cols-[1.1fr_3fr]"><div><span class="flex items-center gap-2  "><svg viewBox="0 0 32 32" width="28" height="28" class="shrink-0 " aria-hidden="true"><defs><mask id="tt-ikon-m-_R_15c_" maskUnits="userSpaceOnUse" x="0" y="0" width="32" height="32"><rect x="3" y="8" width="26" height="16" rx="2.5" fill="#fff"></rect><g fill="#000"><circle cx="3" cy="16" r="3"></circle><circle cx="29" cy="16" r="3"></circle><circle cx="17" cy="16" r="5.6"></circle></g></mask></defs><rect width="32" height="32" rx="7" style="fill:var(--tt-gran)"></rect><g style="fill:var(--tt-paa-gran)"><rect width="32" height="32" mask="url(#tt-ikon-m-_R_15c_)"></rect><rect x="16.2" y="12" width="1.6" height="4.8" rx=".8"></rect><rect x="16.2" y="15.2" width="4" height="1.8" rx=".8"></rect></g></svg><span class="text-lg font-bold tracking-[-0.02em] text-tt-blaek">TimeTrack</span></span><p class="mt-4 max-w-xs text-sm leading-relaxed text-tt-graa">Tidsregistrering med klippekort til selvstændige og små bureauer.</p><p class="mt-4 max-w-xs text-sm leading-relaxed text-tt-graa">Lavet af <a href="https://mahoje.dk" target="_blank" rel="noopener" class="font-medium text-tt-blaek underline underline-offset-2">Mahoje</a> v/ Mads Holst Jensen. CVR 39413892. Database og backup i EU.</p><a class="mt-4 inline-block text-sm font-medium text-tt-gran underline underline-offset-2" href="/tillid">Tillid og data</a></div><div class="grid grid-cols-2 gap-8 sm:grid-cols-4"><div><p class="text-sm font-semibold">Produkt</p><ul class="mt-3 space-y-1.5 text-sm"><li><a class="text-tt-graa underline-offset-2 hover:text-tt-blaek ho