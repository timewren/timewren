  "share_target": {
    "action": "/dashboard/time/new",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "description",
      "text": "notes",
      "url": "url",
      "files": [
        {
          "name": "attachments",
          "accept": [
            "image/*",
            "application/pdf",
            ".doc",
            ".docx",
            ".xls",
            ".xlsx",
            ".txt"
          ]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+timetrack",
      "url": "/dashboard?action=%s"
    }
  ]
}
