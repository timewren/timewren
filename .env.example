# TimeWren configuration. Copy to .env and fill in section 1.
#
#   cp .env.example .env
#   for v in POSTGRES_PASSWORD BETTER_AUTH_SECRET ENCRYPTION_KEY CRON_SECRET; do
#     sed -i "s|^$v=.*|$v=$(openssl rand -hex 32)|" .env   # macOS: sed -i ''
#   done
#   docker compose up -d
#
# Sections 2 and up are optional: every line is commented out, so uncomment only
# what you need. An empty value counts as "not set".
#
# NEXT_PUBLIC_* values are baked into the browser bundle when the image is
# built. After changing one, rebuild: docker compose up -d --build
# Everything else is read at runtime: docker compose up -d is enough.
#
# Full guide: docs/self-hosting.md

# =============================================================================
# 1. REQUIRED
# =============================================================================

# Password for the bundled PostgreSQL. Compose builds DATABASE_URL from it, so
# you do not set DATABASE_URL yourself. Only used when the database is first
# created: changing it later does not change the existing database.
POSTGRES_PASSWORD=

# Session signing secret. Changing it logs everybody out.
BETTER_AUTH_SECRET=

# AES-256-GCM key for stored tokens and credentials (calendar, accounting,
# webhooks). Exactly 64 hex characters. Lose it and those integrations must be
# reconnected, so back it up.
ENCRYPTION_KEY=

# Shared secret between the cron service and the app.
CRON_SECRET=

# Image version to run (default: latest). Pin it, e.g. 1.2.3, to control upgrades.
# TIMEWREN_VERSION=latest

# The URL users open, no trailing slash. Baked in at build time (rebuild after
# changing). Must match what the browser sees: use your https:// domain behind a
# reverse proxy.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Lets people sign up and log in without a mail server. Only honoured while no
# mail transport (section 2) is configured. Anyone who can reach the instance can
# then create an account, so remove it once mail works. The first account becomes
# admin.
REQUIRE_EMAIL_VERIFICATION=false

# =============================================================================
# 2. MAIL (optional, recommended). Pick one: SMTP or Resend.
# =============================================================================
# Without either, mails are written to the server log instead of being sent.

# SMTP_HOST=
# SMTP_PORT=587              # 465 uses implicit TLS
# true = implicit TLS; empty = true only on port 465, else STARTTLS
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="TimeWren <mail@your-domain.example>"   # sender address (recommended with SMTP)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# resend | smtp | log (forces the choice)
# MAIL_TRANSPORT=
# sender for some notification mails
# FROM_EMAIL=
# Resend delivery webhooks (Svix secret)
# RESEND_WEBHOOK_SECRET=
# Resend audience for newsletter signups
# RESEND_AUDIENCE_ID=

# Instance admin(s), comma separated. Empty: the first account created becomes
# admin (only while the instance has no admin).
# ADMIN_EMAIL=
# receives admin alerts and digests
# ADMIN_NOTIFICATION_EMAIL=
# admin alerts and in-app feedback
# ADMIN_DISCORD_WEBHOOK_URL=

# =============================================================================
# 3. FILE STORAGE (optional)
# =============================================================================
# Default in docker-compose.yml: local disk, on the `storage` volume.
# For S3-compatible storage (AWS, Hetzner, MinIO, R2) set STORAGE_DRIVER=s3 and:

# STORAGE_DRIVER=s3
# Local driver outside compose only (compose sets it to /app/data/storage):
# STORAGE_LOCAL_PATH=
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=timetrack
# optional namespace inside the bucket
# S3_PREFIX=

# =============================================================================
# 4. DOMAINS, ORIGINS AND COMPOSE SETTINGS (optional)
# =============================================================================

# Compose: host port and bind address of the app (default 127.0.0.1:3000).
# APP_PORT=3000
# APP_BIND=127.0.0.1         # 0.0.0.0 exposes the port on all interfaces
# Optional automatic HTTPS overlay (DNS must point here; allow TCP 80/443).
# CADDY_DOMAIN=time.example.com
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
# Timezone of the app and database containers. Cron jobs always run in Europe/Copenhagen.
# TZ=Europe/Copenhagen

# Separate public/marketing host (baked in at build time). Empty mirrors
# NEXT_PUBLIC_APP_URL (single host).
# NEXT_PUBLIC_MARKETING_URL=
# Brand (baked in at build time): timewren (default, self-hosting) or timetrack
# (Mahope's Danish cloud). On timewren without NEXT_PUBLIC_MARKETING_URL the
# marketing pages are off: / goes to the dashboard, the rest returns 404.
# NEXT_PUBLIC_BRAND=timewren
# Support address shown in mails and the UI. Empty: support@<EMAIL_DOMAIN>.
# SUPPORT_EMAIL=
# Extra origins accepted by auth/CSRF checks, comma separated.
# TRUSTED_ORIGINS=
# tRPC CORS allowlist (exact origins, comma separated, no paths/wildcards).
# Unset accepts browser-extension origins as before; empty disables CORS.
# CORS_ALLOWED_ORIGINS=https://app.example.org,chrome-extension://extension-id
# Native auth origins, comma separated. Unset keeps the official app schemes.
# Set to an empty value to disable native auth origins.
# APP_SCHEMES=timetrack://,timetrack.preview://
# Device-login callback. Must be a native scheme with exactly auth/callback;
# never a web URL. Keep timetrack:// for the official signed clients.
# DEVICE_CALLBACK_URL=timetrack://auth/callback
# Domain for generated mail addresses (noreply@, task+id@). Empty uses the host
# of NEXT_PUBLIC_MARKETING_URL, else of NEXT_PUBLIC_APP_URL.
# EMAIL_DOMAIN=
# sender of personal mails; empty = default sender
# PERSONAL_FROM_EMAIL=
# PERSONAL_REPLY_TO_EMAIL=
# empty = feedback goes to the Discord webhook only
# FEEDBACK_TO_EMAIL=
# Only with a split app/marketing host:
# share the session cookie, e.g. .example.com
# AUTH_COOKIE_DOMAIN=
# passkey relying-party ID, e.g. example.com
# AUTH_RP_ID=
# default better-auth
# AUTH_COOKIE_PREFIX=
# SUBDOMAIN_REDIRECT_STATUS=307
# base for stored/registered callback links; default NEXT_PUBLIC_APP_URL
# CALLBACK_BASE_URL=

# =============================================================================
# 5. VALKEY (optional): shared rate limits and realtime timer sync
# =============================================================================
# Start with: docker compose --profile valkey up -d   (or COMPOSE_PROFILES=valkey)

# VALKEY_URL=redis://valkey:6379
# RATE_LIMIT_BACKEND=valkey
# REALTIME_ENABLED=true
# NEXT_PUBLIC_REALTIME_ENABLED=true   # build time; both must be true

# =============================================================================
# 6. LOGIN PROVIDERS (optional). Each needs your own OAuth app.
# =============================================================================
# Callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/callback/<provider>

# also used by the Google Calendar integration
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Microsoft Entra ID (Azure AD) sign-in, e.g. for company SSO.
# Callback: {NEXT_PUBLIC_APP_URL}/api/auth/callback/microsoft-entra-id
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common # common | organizations | tenant GUID
# Sign in with Apple
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_APP_BUNDLE_IDENTIFIER= # iOS bundle id (default dk.timetrack.app); native login and revoking it on account deletion
# Hosted TimeWren Cloud only (MULTIBRAND_ENABLED=1, TIMEWREN_APP_ENABLED=1):
# separate OAuth apps for the TimeWren hosts. Without a pair the provider is
# neither registered nor shown there; the keys above are never used for it.
# Callback: https://<timewren host>/api/auth/callback/<provider>
# TIMEWREN_GOOGLE_CLIENT_ID=
# TIMEWREN_GOOGLE_CLIENT_SECRET=
# TIMEWREN_GITHUB_CLIENT_ID=
# TIMEWREN_GITHUB_CLIENT_SECRET=
# TIMEWREN_DISCORD_CLIENT_ID=
# TIMEWREN_DISCORD_CLIENT_SECRET=
# TIMEWREN_MICROSOFT_CLIENT_ID=
# TIMEWREN_MICROSOFT_CLIENT_SECRET=
# TIMEWREN_MICROSOFT_TENANT_ID=common
# TIMEWREN_APPLE_CLIENT_ID= # Services ID; signed with APPLE_TEAM_ID/KEY_ID/PRIVATE_KEY

# =============================================================================
# 7. INTEGRATIONS that need your own credentials (optional)
# =============================================================================
# Billy needs nothing here: each user pastes their own Billy API key in the app.

# Google Calendar: uses GOOGLE_CLIENT_ID/SECRET above. Redirect URI (defaults to
# the value below):
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Dinero (Visma Connect OAuth app)
# DINERO_CLIENT_ID=
# DINERO_CLIENT_SECRET=
# DINERO_REDIRECT_URI=http://localhost:3000/api/integrations/dinero/callback
# DINERO_WEBHOOK_SECRET=
# Billy webhooks (optional)
# BILLY_WEBHOOK_SECRET=

# e-conomic (app registered at https://www.e-conomic.com/developer)
# ECONOMIC_APP_PUBLIC_TOKEN=
# ECONOMIC_APP_SECRET_TOKEN=
# ECONOMIC_REDIRECT_URI=http://localhost:3000/api/integrations/economic/callback

# =============================================================================
# 8. AI, SMS, PUSH, EMAIL-TO-TASK (optional)
# =============================================================================

# AI suggestions and categorisation
# OPENAI_API_KEY=
# SMS login
# MESSAGEBIRD_API_KEY=
# MESSAGEBIRD_ORIGINATOR=TimeWren
# Web Push: generate keys with `npx web-push generate-vapid-keys`
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:you@example.com
# push to the mobile app (optional Expo token)
# EXPO_ACCESS_TOKEN=
# Email-to-task (IMAP sync)
# INBOUND_EMAIL_DOMAIN=
# EMAIL_ATTACHMENT_DIR=storage/email-attachments
# EMAIL_SYNC_STORE_ATTACHMENTS=false   # true uploads attachments to storage (S3 or local)
# CVR lookup (Danish company register). Empty key falls back to cvrapi.dk.
# CVR_SERVICE_API_KEY=
# CVR_SERVICE_URL=
# changelog and desktop-update lookups (higher rate limit)
# GITHUB_TOKEN=
# Optional GitHub owner/repo for downloads, legacy Tauri updates and changelog.
# TimeWren leaves these disabled unless configured. TimeTrack Cloud retains
# its existing repositories. The first variable is baked in at build time.
# NEXT_PUBLIC_DESKTOP_RELEASES_REPO=
# DESKTOP_UPDATER_REPO=
# CHANGELOG_REPO=

# =============================================================================
# 9. TELEMETRY: none by default
# =============================================================================
# Nothing is sent to the maintainers unless you set these.

# build time; analytics script URL
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=
# Optional Umami tool events on the TimeTrack marketing site (build time)
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=
# NEXT_PUBLIC_UMAMI_COLLECT_URL=
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# PLAUSIBLE_BASE_URL=
# PLAUSIBLE_SITE_ID=
# PLAUSIBLE_API_KEY=
# build time
# NEXT_PUBLIC_SENTRY_DSN=
# build time; false disables browser Sentry
# NEXT_PUBLIC_SENTRY_BROWSER_ENABLED=
# build time
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# SENTRY_AUTH_TOKEN=
# SENTRY_ACCESS_TOKEN=
# SENTRY_API_URL=
# SENTRY_WEBHOOK_SECRET=

# =============================================================================
# 10. TUNING (optional)
# =============================================================================

# SESSION_EXPIRY_DAYS=7
# FREE_TRIAL_DAYS=30
# DEFAULT_WEEKLY_HOUR_GOAL=37
# PRODUCTIVITY_HEATMAP_DAYS=90
# PREPAID_LOW_BALANCE_THRESHOLD=0.2
# PREPAID_CRITICAL_BALANCE_HOURS=1
# PREPAID_EXPIRY_WARNING_DAYS=30
# CVR_API_TIMEOUT_MS=10000
# AI_CACHE_TTL_MS=60000
# AI_HIGH_CONFIDENCE_THRESHOLD=0.8
# MAX_MONETARY_AMOUNT=100000000
# PDF_ENGINE=react-pdf       # takumi = experimental invoice renderer
# 1 switches the churn-playbook cron job off
# CHURN_PLAYBOOKS_DISABLED=
# MIGRATION_LOCK_TIMEOUT_MS=
# versioned secrets for rotating BETTER_AUTH_SECRET
# BETTER_AUTH_SECRETS=
# e.g. extension=2.5.2,mobile=1.0.0+5,desktop=0.2.21
# MIN_CLIENT_VERSIONS=
# observe = evaluate without rejecting
# MIN_CLIENT_VERSIONS_MODE=
# test accounts excluded from stats (comma separated)
# SYNTHETIC_USER_EMAILS=
# SYNTHETIC_USER_IDS=
# experimental ElectricSQL timer shape proxy
# ELECTRIC_URL=
# ELECTRIC_SECRET=
# SEED_DEMO_ORGS=false       # true seeds a demo organisation on startup
# 1 when sharing the database with an older version
# SHARED_PROD_DB=

# =============================================================================
# 11. HOSTED SERVICE ONLY: leave unset when self-hosting
# =============================================================================
# Billing is on only when one of ALUNTA_API_KEY, STRIPE_SECRET_KEY or
# STORE_BILLING_ENABLED=1 is set. Left unset, every feature is open and there
# are no user limits, trials or upgrade buttons.

# ALUNTA_API_KEY=
# required with ALUNTA_API_KEY: without it the webhook answers 503
# ALUNTA_WEBHOOK_SECRET=
# dev only, ignored when NODE_ENV=production
# ALUNTA_WEBHOOK_ALLOW_UNSIGNED=
# ALUNTA_PLAN_MONTHLY=
# ALUNTA_PLAN_YEARLY=
# ALUNTA_PLAN_TEAM_MONTHLY=
# ALUNTA_PLAN_TEAM_YEARLY=
# ALUNTA_PLAN_BUSINESS_MONTHLY=
# ALUNTA_PLAN_BUSINESS_YEARLY=
# ALUNTA_PLAN_TEAM_SEATS=
# ALUNTA_PLAN_BUSINESS_SEATS=
# ALUNTA_PLAN_PRIVAT_MONTHLY=
# ALUNTA_PLAN_PRIVAT_YEARLY=
# ALUNTA_PLAN_FOUNDING_MONTHLY=
# ALUNTA_PLAN_FOUNDING_YEARLY=
# ALUNTA_PLAN_LEGACY_SOLO=
# ALUNTA_PLAN_LEGACY_TEAM=
# ALUNTA_PLAN_LEGACY_BUSINESS=
# ALUNTA_PLAN_LEGACY_TEAM_SEATS=
# ALUNTA_PLAN_LEGACY_BUSINESS_SEATS=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_TAX_ENABLED=
# STRIPE_DESKTOP_LIFETIME_PRICE_ID=
# Multibrand Cloud only: Stripe billing portal configuration for TimeWren
# accounts (optional; found or created by metadata brand=timewren otherwise).
# Set one yourself only with subscription_update.trial_update_behavior=
# continue_trial, or plan changes during the trial charge immediately.
# STRIPE_TIMEWREN_PORTAL_CONFIGURATION=
# STORE_BILLING_ENABLED=
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# GOOGLE_PLAY_PACKAGE_NAME=
# GOOGLE_PLAY_WEBHOOK_TOKEN=
# DOKPLOY_API_URL=
# DOKPLOY_API_TOKEN=
# DOKPLOY_APP_ID=
# CLAUDE_AGENT_API_KEY=
# CLAUDE_AGENT_TRIGGER_URL=
# UNBLOCK_PLAN_EMAIL=
# UNBLOCK_PLAN_TIER=
# UNBLOCK_PLAN_SEATS=

# =============================================================================
# Brands, contact addresses and diagnostics (all optional)
# =============================================================================
# Personal contact address shown on marketing pages and in personal mails.
# Default: the support address (SUPPORT_EMAIL).
# CONTACT_EMAIL=
# SUPPORT_EMAIL=
# NEXT_PUBLIC_SUPPORT_EMAIL=
# Multi-brand hosting (one instance serving several brand hosts). BRANDS_CONFIG is
# JSON that overrides the host/mail/colour defaults, e.g. {"timewren":{"hosts":["example.org"]}}.
# MULTIBRAND_ENABLED=
# BRANDS_CONFIG=
# Open the app and allow indexing on non-default brand hosts (both off by default).
# TIMEWREN_APP_ENABLED=
# TIMEWREN_INDEXABLE=
# Version string used by the PWA update check. Read at runtime; the Docker
# image sets it from the APP_VERSION build arg.
# APP_VERSION=
# Google Ads tag ID (baked in at build time). Unset = no tag.
# NEXT_PUBLIC_GOOGLE_ADS_ID=
# Log DB query counts per tRPC request. Development only; ignored in production.
# TT_QUERY_COUNT=

# =============================================================================
# DEVELOPMENT without Docker (npm run dev): put these in .env.local instead
# =============================================================================
# npm run docker:up starts PostgreSQL from docker-compose.dev.yml.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freelance_crm
