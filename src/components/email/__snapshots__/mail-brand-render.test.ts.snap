[data-ogsb] .tt-card table[style*="background"]:not(.tt-keep), [data-ogsb] .tt-card td[style*="background"]:not(.tt-btn-td):not(.tt-hul), [data-ogsb] .tt-card div[style*="background"], [data-ogsb] .tt-card p[style*="background"] { background-color: #1C201E !important; }
[data-ogsb] .tt-card td.tt-btn-td, [data-ogsb] .tt-card a.tt-btn { background-color: #5FB38F !important; }
[data-ogsb] .tt-card td.tt-btn-td-secondary, [data-ogsb] .tt-card a.tt-btn-secondary { background-color: transparent !important; border-color: #6B736F !important; }
[data-ogsb] .tt-card td.tt-hul-brugt { background-color: #5FB38F !important; border-color: #5FB38F !important; }
[data-ogsb] .tt-card td.tt-hul-halv { background-color: #18291F !important; border-color: #5FB38F !important; }
