FE2DE"><tbody><tr><td style="font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;padding:10px 0"><p style="color:#1A1D1C;font-size:15px;font-weight:600;line-height:22px;margin:0">Opgave<span style="color:#8A1C13;font-size:13px;font-weight:600">  <!-- -->Haster</span></p><p class="tt-muted" style="color:#5F6663;font-size:14px;line-height:20px;margin:2px 0 0 0">Frist i dag</p></td></tr></tbody></table><table role="presentation" border="0" cellPadding="0" cellSpacing="0" width="100%" style="border-collapse:separate;margin:8px 0 16px"><tbody><tr><td bgcolor="#F2F3F0" style="background-color:#F2F3F0;border-radius:8px;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;padding:14px 14px;vertical-align:top;width:50%"><p class="tt-muted" style="color:#5F6663;font-size:13px;line-height:18px;margin:0 0 4px 0">Færdige i går</p><p style="color:#1A1D1C;font-size:22px;font-variant-numeric:tabular-nums;font-weight:700;line-height:28px;margin:0">1</p></td><td width="8" style="width:8px"></td><td bgcolor="#F2F3F0" style="background-color:#F2F3F0;border-radius:8px;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;padding:14px 14px;vertical-align:top;width:50%"><p class="tt-muted" style="color:#5F6663;font-size:13px;line-height:18px;margin:0 0 4px 0">Planlagt i dag</p><p style="color:#1A1D1C;font-size:22px;font-variant-numeric:tabular-nums;font-weight:700;line-height:28px;margin:0">1</p></td></tr></tbody></table><table role="presentation" border="0" cellPadding="0" cellSpacing="0" style="margin:8px 0 24px"><tbody><tr><td class="tt-btn-td" bgcolor="#1E5B47" style="background-color:#1E5B47;border-radius:8px"><a href="https://example.com/x" class="tt-btn" style="background-color:#1E5B47;border:1px solid #1E5B47;border-radius:8px;color:#FFFFFF;display:inline-block;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:16px;font-weight:600;line-height:20px;padding:13px 22px;text-decoration:none">Se alle opgaver</a></td></tr></tbody></table></td></tr><tr><td class="tt-footer" style="padding:16px 4px 0"><p style="font-size:12px;line-height:18px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 4px 0;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">Du modtager denne mail, fordi du har slået mailnotifikationer til i TimeTrack.<!-- --> <a href="http://localhost:3000/dashboard/settings/notifications" style="color:#5F6663;text-decoration-line:none;text-decoration:underline" target="_blank">Mailindstillinger</a></p><p style="font-size:12px;line-height:18px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 4px 0;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0"><a href="http://localhost:3000" style="color:#5F6663;text-decoration-line:none;text-decoration:underline" target="_blank">TimeTrack</a> <!-- -->er lavet af Mahoje v/ Mads Holst Jensen, CVR 39413892.</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"
`;

