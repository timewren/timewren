  "scripts": {
    "dev": "next dev",
    "dev:bg": "tsx scripts/dev-bg.ts",
    "dev:stop": "tsx scripts/dev-stop.ts",
    "dev:pw": "node scripts/dev-pw.mjs",
    "setup": "node scripts/dev-init.mjs && npm install && npm run dev:setup",
    "dev:setup": "npm run docker:up && npm run db:migrate && npm run db:seed && npm run dev:bg",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:copy": "node scripts/brand/lint-copy.mjs",
    "release:check": "node scripts/release/check.mjs",
    "release:next": "node scripts/release/next-version.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run lint:copy && node scripts/check-migration-journal.mjs && npm run i18n:check && npm test",
    "i18n:check": "node scripts/i18n/build-loader.mjs --check && node scripts/i18n/check.mjs && node scripts/i18n/check-keys.mjs",
    "i18n:build": "node scripts/i18n/build-loader.mjs",
    "format": "biome format --write",
    "test": "npm run test:unit",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:model": "vitest run --config vitest.dbtest.config.ts",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-safe.ts",
    "db:migrate-force": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "deploy:migrate": "npm run db:migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:push": "drizzle-kit push",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "brand:icons": "node scripts/brand/generate-icons.mjs",
    "pwa:screenshots": "node scripts/capture-screenshots.mjs",
    "pwa:marketing": "node scripts/capture-marketing-screenshots.mjs",
    "screenshots:timewren": "tsx scripts/screenshots/timewren.ts",
    "screenshots:timewren:local": "tsx scripts/screenshots/run-local.ts",
    "screenshots:seed": "tsx scripts/screenshots/seed-demo.ts"
  },
