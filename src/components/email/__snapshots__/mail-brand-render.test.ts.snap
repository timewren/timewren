[data-ogsb] .tt-card td, [data-ogsb] .tt-card th, [data-ogsb] .tt-card hr, [data-ogsb] .tt-card { border-color: #2A2F2D !important; }</style></head><body class="tt-body" style="background-color:#F2F3F0;margin:0;padding:0"><!--$--><!--html--><!--head--><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Uge 45: 30 t og 20.000 kr.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#F2F3F0;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0;padding:0"><table role="presentation" border="0" cellPadding="0" cellSpacing="0" width="100%" class="tt-page" bgcolor="#F2F3F0" style="background-color:#F2F3F0"><tbody><tr><td align="center" style="padding:24px 12px"><table role="presentation" border="0" cellPadding="0" cellSpacing="0" width="100%" style="max-width:600px;margin:0 auto"><tbody><tr><td class="tt-header" data-skip-in-text="true" style="padding:0 4px 16px"><table role="presentation" border="0" cellPadding="0" cellSpacing="0" width="100%"><tbody><tr><td style="vertical-align:middle"><a href="http://localhost:3000" style="color:#1A1D1C;text-decoration:none"><img alt="" height="32" src="https://timetrack.dk/brand/tt-ikon-64.png" style="display:inline-block;outline:none;border:0;text-decoration:none;height:32px;vertical-align:middle;width:32px" width="32"/><span class="tt-wordmark" style="color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:18px;font-weight:700;letter-spacing:-0.02em;line-height:32px;padding-left:10px;vertical-align:middle">TimeTrack</span></a></td><td align="right" class="tt-muted" style="color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:13px;line-height:32px;vertical-align:middle">Ugeopsummering</td></tr></tbody></table></td></tr><tr><td class="tt-card" bgcolor="#FFFFFF" style="background-color:#FFFFFF;border:1px solid #DFE2DE;border-radius:10px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;padding:32px 28px"><h1 style="color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:24px;font-weight:700;letter-spacing:-0.02em;line-height:30px;margin:0 0 16px 0">Uge 45, 2026</h1><p style="font-size:16px;line-height:24px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Hej Test,</p><p style="font-size:16px;line-height:24px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Her er din uge i tal.</p><table role="presentation" border="0" cellPadding="0" cellSpacing="0" width="100%" style="border-collapse:separate;margin:8px 0 16px"><tbody><tr><td bgcolor="#F2F3F0" style="background-color:#F2F3F0;border-radius:8px;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;padding:14px 14px;vertical-align:top;width:33%"><p class="tt-muted" style="color:#5F6663;font-size:13px;line-height:18px;margin:0 0 4px 0">Timer</p><p style="color:#1A1D1C;font-size:22px;font-variant-numeric:tabular-nums;font-weight:700;line-height:28px;margin:0">30 t</p><p style="color:#5F6663;font-size:13px;line-height:18px;margin:4px 0 0 0">20 % mere end sidste uge</p></td><td width="8" style="width:8px"></td><td bgcolor="#F2F3F0" style="background-color:#F2F3F0;border-radius:8px;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;padding:14px 14px;vertical-align:top;width:33%"><p class="tt-muted" style="color:#5F6663;font-size:13px;line-height:18px;margin:0 0 4px 0">Omsætning</p><p style="color:#1A1D1C;font-size:22px;font-variant-numeric:tabular-nums;font-weight:700;line-height:28px;margin:0">20.000 kr.</p><p style="color:#5F6663;font-size:13px;line-height:18px;margin:4px 0 0 0">33 % mere end sidste uge</p></td><td width="8" style="width:8px"></td><td bgcolor="#F2F3F0" style="background-color:#F2F3F0;border-radius:8px;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;padding:14px 14px;vertical-align:top;width:33%"><p class="tt-muted" style="color:#5F6663;font-size:13px;line-height:18px;margin:0 0 4px 0">Dage med tid</p><p style="color:#1A1D1C;font-size:22px;font-variant-numeric:tabular-nums;font-weight:700;line-height:28px;margin:0">4 af 5</p></td></tr></tbody></table><p style="font-size:16px;line-height:24px;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Du har <strong>5.000 kr.</strong> i timer, der endnu ikke er faktureret.</p><table style="border-collapse:collapse;margin:8px 0 16px;width:100%"><thead><tr><th class="tt-muted" style="border-bottom:1px solid #DFE2DE;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:13px;font-weight:600;padding:6px 0;text-align:left">Kunde</th><th class="tt-muted" style="border-bottom:1px solid #DFE2DE;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:13px;font-weight:600;padding:6px 0;text-align:right">Timer</th><th class="tt-muted" style="border-bottom:1px solid #DFE2DE;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:13px;font-weight:600;padding:6px 0;text-align:right">Omsætning</th></tr></thead><tbody><tr><td style="border-bottom:1px solid #DFE2DE;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:15px;padding:8px 0">Kunde</td><td style="border-bottom:1px solid #DFE2DE;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:15px;padding:8px 0;font-variant-numeric:tabular-nums;text-align:right">10</td><td style="border-bottom:1px solid #DFE2DE;color:#1A1D1C;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:15px;padding:8px 0;font-variant-numeric:tabular-nums;text-align:right">5.000 kr.</td></tr></tbody></table><table role="presentation" border="0" cellPadding="0" cellSpacing="0" style="margin:8px 0 24px"><tbody><tr><td class="tt-btn-td" bgcolor="#1E5B47" style="background-color:#1E5B47;border-radius:8px"><a href="https://timetrack.dk/dashboard/week-review" class="tt-btn" style="background-color:#1E5B47;border:1px solid #1E5B47;border-radius:8px;color:#FFFFFF;display:inline-block;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;font-size:16px;font-weight:600;line-height:20px;padding:13px 22px;text-decoration:none">Åbn ugens afslutning</a></td></tr></tbody></table><p style="font-size:14px;line-height:20px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:16px 0 0 0;margin-top:16px;margin-right:0;margin-bottom:0;margin-left:0">Ugeopsummeringen kan slås fra under mailindstillinger.</p></td></tr><tr><td class="tt-footer" style="padding:16px 4px 0"><p style="font-size:12px;line-height:18px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 4px 0;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">Rapporten sendes hver mandag.<!-- --> <a href="http://localhost:3000/dashboard/settings/notifications" style="color:#5F6663;text-decoration-line:none;text-decoration:underline" target="_blank">Mailindstillinger</a></p><p style="font-size:12px;line-height:18px;color:#5F6663;font-family:&quot;Schibsted Grotesk&quot;, Arial, sans-serif;margin:0 0 4px 0;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0"><a href="http://localhost:3000" style="color:#5F6663;text-decoration-line:none;text-decoration:underline" target="_blank">TimeTrack</a> <!-- -->er lavet af Mahoje v/ Mads Holst Jensen, CVR 39413892.</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"
`;

exports[`mails til en TimeTrack-konto er uændrede > WelcomeEmail 1`] = `
"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="da"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><meta name="color-scheme" content="light dark"/><meta name="supported-color-schemes" content="light dark"/><meta name="x-apple-disable-message-reformatting"/><meta name="format-detection" content="telephone=no, date=no, address=no, email=no"/><style>:root { color-scheme: light dark; supported-color-schemes: light dark; }
@media (prefers-color-scheme: dark) {
.tt-card h1, .tt-card h2, .tt-card strong { color: #ECEFED !important; }
.tt-card p, .tt-card td, .tt-card th, .tt-card div, .tt-card li { color: #ECEFED !important; }
.tt-card .tt-kv-label, .tt-card .tt-muted, .tt-footer p, .tt-header .tt-muted { color: #A3ABA7 !important; }
.tt-card .tt-kv-value { color: #ECEFED !important; }
.tt-card a:not([style*="background"]), .tt-footer a { color: #5FB38F !important; }
.tt-header .tt-wordmark { color: #ECEFED !important; }
.tt-card a.tt-btn { color: #0A0A0A !important; }
.tt-card a.tt-btn-secondary { color: #ECEFED !important; }
.tt-body, .tt-body > table > tbody > tr > td, .tt-page { background-color: #0A0A0A !important; }
.tt-card { background-color: #151816 !important; }
.tt-card table[style*="background"]:not(.tt-keep), .tt-card td[style*="background"]:not(.tt-btn-td):not(.tt-hul), .tt-card div[style*="background"], .tt-card p[style*="background"] { background-color: #1C201E !important; }
.tt-card td.tt-btn-td, .tt-card a.tt-btn { background-color: #5FB38F !important; }
.tt-card td.tt-btn-td-secondary, .tt-card a.tt-btn-secondary { background-color: transparent !important; border-color: #6B736F !important; }
