{
  "name": "timetrack-extension",
  "version": "2.8.1",
  "license": "MIT",
  "description": "TimeTrack Browser Extension - Tidsregistrering direkte fra browseren",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "build:firefox": "vite build --mode firefox",
    "build:all": "npm run build && npm run build:firefox",
    "package": "npm run build:all && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@electric-sql/client": "^1.5.28",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@sentry/browser": "^10.78.0",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-static-copy": "^3.4.0"
  },
  "overrides": {
    "rollup": "4.67.4"
  }
}
