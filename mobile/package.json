{
  "name": "timetrack-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "prebuild": "pnpm expo prebuild",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor@latest",
    "preinstall": "npx only-allow pnpm",
    "start:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview pnpm run start",
    "prebuild:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "prebuild:development": "cross-env EXPO_PUBLIC_APP_ENV=development STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "android:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview pnpm run android",
    "start:production": "cross-env EXPO_PUBLIC_APP_ENV=production pnpm run start",
    "prebuild:production": "cross-env EXPO_PUBLIC_APP_ENV=production STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "android:production": "cross-env EXPO_PUBLIC_APP_ENV=production pnpm run android",
    "build:development:ios": "eas build --profile development --platform ios",
    "build:development:android": "eas build --profile development --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:production:ios": "eas build --profile production --platform ios",
    "build:production:android": "eas build --profile production --platform android",
    "prepare": "husky",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content",
    "type-check": "cross-env NODE_OPTIONS=--max-old-space-size=6144 tsc --noemit",
    "lint:translations": "eslint ./src/translations/ --fix --ext .json",
    "check:classname": "node scripts/check-classname.mjs",
    "check:permissions": "node scripts/check-native-permissions.mjs",
    "test": "cross-env TZ=Europe/Copenhagen jest",
    "check-all": "node scripts/run-parallel.mjs lint,lint:translations type-check check:classname,check:permissions test",
    "test:ci": "pnpm run test --coverage",
    "test:watch": "pnpm run test --watch",
    "install-maestro": "curl -Ls 'https://get.maestro.mobile.dev' | bash",
    "e2e-test": "maestro test .maestro/ -e APP_ID=dk.timetrack.app.development"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.27",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "^6.1.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@sentry/react-native": "~7.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.104.0",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "app-icon-badge": "^0.1.2",
    "better-auth": "1.7.27",
    "date-fns": "^4.4.0",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "^15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-iap": "6.1.1",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.22",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "i18next": "^26.4.2",
    "lodash.memoize": "^4.1.2",
    "lucide-react-native": "^1.49.0",
    "moti": "^0.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.81.5",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "^1.18.5",
    "react-native-mmkv": "~4.1.1",
    "react-native-nitro-modules": "^0.33.2",
    "react-native-reanimated": "~4.1.6",
    "react-native-restart": "0.0.27",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "^4.16.0",
    "react-native-svg": "~15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "^0.7.2",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "uniwind": "^1.2.4",
    "zod": "4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@babel/core": "^7.28.6",
    "@babel/parser": "^7.29.7",
    "@dev-plugins/react-query": "^0.4.0",
    "@eslint-react/eslint-plugin": "^5.23.3",
    "@expo/config": "~12.0.13",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/invariant": "^2.2.37",
    "@types/jest": "^29.5.14",
    "@types/lodash.memoize": "^4.1.9",
    "@types/react": "~19.1.17",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-testing-library": "^7.15.4",
    "eslint-plugin-unicorn": "^62.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "jest-junit": "^16.0.0",
    "lint-staged": "^16.2.7",
    "tailwindcss": "4.1.18",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@>=3": "^5.0.12",
      "fast-uri": "3.1.9",
      "postcss": "^8.5.23",
      "undici": "6.29.1",
      "uuid": "^11.1.1",
      "compression@1": "1.8.2",
      "follow-redirects@1": "1.16.2",
      "glob@>=10": "14.0.2",
      "katex@0.16": "0.18.2",
      "minimatch@>=7": "11.0.1",
      "node-forge@1": "1.4.3",
      "postcss-selector-parser@7": "7.1.6",
      "shell-quote@1": "1.11.0",
      "source-map-js@1": "1.2.2",
      "zod@4": "4.6.6"
    },
    "patchedDependencies": {
      "eslint-plugin-i18n-json@4.0.1": "patches/eslint-plugin-i18n-json@4.0.1.patch"
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-restart",
          "react-native-edge-to-edge"
        ]
      }
    },
    "install": {
      "exclude": [
        "eslint-config-expo",
        "react-native-worklets",
        "typescript"
      ]
    }
  },
  "license": "AGPL-3.0-only"
}
