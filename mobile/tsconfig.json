{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "paths": {
      "env": ["./env.ts"],
      "~/*": ["./src/*"],
      "@env": ["./env.ts"],
      "@/lib/pdf-svg": ["./src/types/web-pdf-svg-shim.ts"],
      "@/*": ["../src/*"],
      "messagebird": ["./src/types/messagebird-shim.d.ts"]
    },
    "checkJs": true,
    "strict": true,
    "esModuleInterop": true,
    "types": ["jest", "node"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "env.ts"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "android",
    "ios",
    "lint-staged.config.js",
    "tsconfig.probe.json"
  ]
}
