{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "TimeTrack",
  "identifier": "dk.timetrack.desktop",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mahope/timetrack-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5QzFFQkMwNTg3MzMzNTAKUldSUU0zTll3T3ZCZWJaMkVYOFpnaXFFVmhyTGZQZkJqODhTU0hGODRBZ0QxVDlNSUZYaVN0cVcK"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["timetrack"]
      }
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TimeTrack",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://timetrack.dk https://app.timetrack.dk https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com https://openrouter.ai https://api.billysbilling.com https://*.ingest.us.sentry.io; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": "entitlements.mac.plist"
    },
    "category": "Productivity"
  }
}
